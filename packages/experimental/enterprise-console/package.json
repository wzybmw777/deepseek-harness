{
  "name": "@deepseek-ai/dsh-enterprise-console",
  "description": "Enterprise SaaS shell, administration API, and isolated tenant Harness gateway",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
